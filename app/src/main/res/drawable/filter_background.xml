<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/trail_primary_container">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/trail_surface" />
                    <stroke android:width="1dp" android:color="@color/trail_outline" />
                    <corners android:radius="@dimen/trail_corner_radius" />
                </shape>
            </item>
            <item android:drawable="@drawable/ic_expand_more"
                android:gravity="end|center_vertical" android:right="16dp" />
        </layer-list>
    </item>
</ripple>
