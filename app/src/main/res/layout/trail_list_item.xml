<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:minHeight="72dp"
    app:cardBackgroundColor="@color/trail_surface"
    app:cardCornerRadius="@dimen/trail_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="@color/trail_outline"
    app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="14dp">
        <TextView android:id="@+id/trail_row_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/trail_on_surface" android:maxLines="2" />
        <TextView android:id="@+id/trail_row_meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/trail_primary" android:maxLines="2" />
        <TextView android:id="@+id/trail_row_detail" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/trail_on_surface_variant" android:maxLines="2"
            android:ellipsize="end" android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
