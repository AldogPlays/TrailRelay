<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/map_status_scrim"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        android:background="@drawable/status_background"
        android:elevation="4dp"
        android:padding="16dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/trail_on_surface"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selected_offline"
            style="@style/Widget.TrailRelay.MapButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            android:text="@string/download_offline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/my_trails"
            style="@style/Widget.TrailRelay.MapButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_trails" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/recenter"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/recenter_background"
        android:contentDescription="@string/recenter"
        android:elevation="4dp"
        android:padding="12dp"
        android:src="@drawable/ic_recenter"
        android:tint="@color/trail_on_surface" />
</FrameLayout>
