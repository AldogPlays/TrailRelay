<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <org.maplibre.android.maps.MapView android:id="@+id/map_view"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <View android:id="@+id/map_system_scrim" android:layout_width="match_parent"
        android:layout_height="0dp" android:background="@drawable/map_status_scrim"
        android:importantForAccessibility="no" />
    <View android:id="@+id/map_navigation_scrim" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_gravity="bottom" android:rotation="180"
        android:background="@drawable/map_status_scrim" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/map_top_controls" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_gravity="top"
        android:layout_margin="@dimen/space_content" android:orientation="vertical">
        <com.google.android.material.button.MaterialButton android:id="@+id/explore"
            style="@style/Widget.TrailRelay.MapButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/explore"
            app:icon="@drawable/ic_explore" />
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_related"
            android:background="@drawable/status_background" android:padding="@dimen/space_content"
            android:minHeight="@dimen/touch_target" android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/trail_on_surface" android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/speed_hud" android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target" android:layout_gravity="top|end"
        android:layout_margin="@dimen/space_content" android:gravity="center"
        android:minWidth="72dp" android:paddingStart="@dimen/space_compact"
        android:paddingEnd="@dimen/space_compact" android:background="@drawable/status_background"
        android:elevation="4dp" android:text="@string/speed_unavailable"
        android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="@color/trail_on_surface" />

    <FrameLayout android:id="@+id/selection_card" android:layout_width="match_parent"
        android:layout_height="0dp" android:background="?attr/colorSurface"
        android:visibility="gone" app:behavior_draggable="true" app:behavior_fitToContents="true"
        app:behavior_hideable="false" app:behavior_peekHeight="0dp"
        app:layout_behavior="@string/bottom_sheet_behavior">
        <androidx.core.widget.NestedScrollView android:id="@+id/selection_scroll"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:clipToPadding="true">
            <LinearLayout android:id="@+id/selection_content" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="0dp">
                <LinearLayout android:id="@+id/selection_summary" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:background="?attr/colorSurface"
                    android:orientation="vertical">
                    <View android:id="@+id/selection_divider" android:layout_width="match_parent"
                        android:layout_height="1dp" android:background="@color/trail_outline" />
                    <LinearLayout android:id="@+id/selection_summary_content"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal"
                        android:background="?attr/selectableItemBackground" android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="@dimen/space_content" android:paddingEnd="@dimen/space_tight"
                        android:paddingTop="@dimen/space_related" android:paddingBottom="@dimen/space_related">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/selection_name" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:maxLines="1"
                                android:ellipsize="end" android:textAppearance="?attr/textAppearanceTitleMedium" />
                            <TextView android:id="@+id/selection_summary_meta" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_tight"
                                android:maxLines="1" android:ellipsize="end"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />
                            <TextView android:id="@+id/selection_summary_status" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_tight"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/trail_on_surface_variant" android:visibility="gone" />
                        </LinearLayout>
                        <ImageButton android:id="@+id/selection_expand" android:layout_width="@dimen/touch_target"
                            android:layout_height="@dimen/touch_target" android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/expand_trail_details" android:padding="@dimen/space_related"
                            android:src="@drawable/ic_expand_less" android:tint="@color/trail_on_surface" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/selection_clear"
                            style="@style/Widget.TrailRelay.OutlinedButton" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minWidth="0dp"
                            android:text="@string/clear_selection" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/selection_expanded" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:paddingStart="@dimen/space_content" android:paddingEnd="@dimen/space_content"
                    android:paddingBottom="@dimen/space_content" android:visibility="gone">
                    <TextView android:id="@+id/selection_meta" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" />
                    <TextView android:id="@+id/selection_source" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_tight"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/trail_on_surface_variant" />
                    <TextView android:id="@+id/selection_description" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_related"
                        android:textAppearance="?attr/textAppearanceBodyMedium" android:visibility="gone" />
                    <com.google.android.material.chip.ChipGroup android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_related"
                        app:chipSpacingHorizontal="@dimen/space_related">
                        <com.google.android.material.chip.Chip android:id="@+id/selection_route_chip"
                            style="@style/Widget.TrailRelay.StatusChip" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <com.google.android.material.chip.Chip android:id="@+id/selection_aerial_chip"
                            style="@style/Widget.TrailRelay.StatusChip" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.chip.ChipGroup>
                    <TextView android:id="@+id/selection_message" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall"
                        android:accessibilityLiveRegion="polite" android:visibility="gone" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/selection_progress" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_related"
                        android:visibility="gone" />
                    <TextView android:id="@+id/selection_offline_state" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall"
                        android:visibility="gone" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_related" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/selection_details"
                            style="@style/Widget.TrailRelay.OutlinedButton" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/trail_details" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/selection_action"
                            style="@style/Widget.TrailRelay.MapButton" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_related" android:text="@string/download_trail" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/selection_open_maps"
                        style="@style/Widget.TrailRelay.OutlinedButton" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_related"
                        android:text="@string/open_in_maps" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <LinearLayout android:id="@+id/location_controls" android:layout_width="@dimen/touch_target"
        android:layout_height="wrap_content" android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_content" android:layout_marginBottom="@dimen/space_content"
        android:orientation="vertical" android:elevation="4dp">
        <ImageButton android:id="@+id/orientation" android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target" android:background="@drawable/recenter_background"
            android:padding="@dimen/space_compact" android:src="@drawable/ic_north_up"
            android:tint="@color/trail_on_surface" android:contentDescription="@string/orientation_north_up" />
        <ImageButton android:id="@+id/recenter" android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target" android:layout_marginTop="@dimen/space_related"
            android:background="@drawable/recenter_background" android:contentDescription="@string/recenter"
            android:padding="@dimen/space_compact" android:src="@drawable/ic_recenter"
            android:tint="@color/trail_on_surface" />
    </LinearLayout>
    <ImageButton android:id="@+id/map_layers" android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target" android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/space_content" android:layout_marginBottom="@dimen/space_content"
        android:background="@drawable/recenter_background" android:padding="@dimen/space_compact"
        android:src="@drawable/ic_map_layers" android:tint="@color/trail_on_surface"
        android:contentDescription="@string/map_selector_description" android:elevation="4dp" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
