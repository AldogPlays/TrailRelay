<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_related"
    app:cardBackgroundColor="@color/trail_surface_variant"
    app:cardCornerRadius="@dimen/trail_corner_radius"
    app:cardElevation="0dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_content">
        <TextView android:id="@+id/offline_item_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_related" app:chipSpacingHorizontal="@dimen/space_related"
            app:chipSpacingVertical="@dimen/space_tight" app:singleLine="false">
            <com.google.android.material.chip.Chip
                android:id="@+id/offline_item_route_chip"
                style="@style/Widget.TrailRelay.StatusChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.chip.Chip
                android:id="@+id/offline_item_aerial_chip"
                style="@style/Widget.TrailRelay.StatusChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/offline_item_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_compact"
            android:indeterminate="true"
            android:visibility="gone" />
        <TextView android:id="@+id/offline_item_state"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_related" android:textAppearance="?attr/textAppearanceBodyMedium"
            android:accessibilityLiveRegion="polite" />
        <TextView
            android:id="@+id/offline_item_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_related"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/trail_on_surface_variant" />
        <TextView android:id="@+id/offline_item_note"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_related" android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/trail_on_surface_variant" android:visibility="gone" />
        <View android:id="@+id/offline_item_divider"
            android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_compact" android:background="@color/trail_outline" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_related" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/offline_item_resume"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/resume_offline"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/offline_item_pause"
                style="@style/Widget.TrailRelay.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/pause_offline"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/offline_item_remove_route"
                style="@style/Widget.TrailRelay.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/remove_route"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/offline_item_delete"
                style="@style/Widget.TrailRelay.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_related" android:layout_weight="1"
                android:text="@string/remove_offline" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
