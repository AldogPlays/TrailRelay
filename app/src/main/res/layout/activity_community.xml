<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/community_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical">
    <Button android:id="@+id/community_back" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/back_to_map" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="16dp" android:text="@string/community"
        android:textAppearance="?android:attr/textAppearanceLarge" android:accessibilityHeading="true" />
    <EditText android:id="@+id/community_search" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginHorizontal="16dp"
        android:hint="@string/search_community" android:inputType="text" android:maxLines="1"
        android:imeOptions="actionDone" android:autofillHints="" />
    <Spinner android:id="@+id/state_filter" android:layout_width="match_parent"
        android:layout_height="48dp" android:contentDescription="@string/state_filter" />
    <Spinner android:id="@+id/difficulty_filter" android:layout_width="match_parent"
        android:layout_height="48dp" android:contentDescription="@string/difficulty_filter" />
    <Spinner android:id="@+id/vehicle_filter" android:layout_width="match_parent"
        android:layout_height="48dp" android:contentDescription="@string/vehicle_filter" />
    <ProgressBar android:id="@+id/community_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" />
    <TextView android:id="@+id/community_message" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="12dp" android:accessibilityLiveRegion="polite" />
    <ListView android:id="@+id/community_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
