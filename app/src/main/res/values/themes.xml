<resources>
    <style name="Theme.TrailRelay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/trail_primary</item>
        <item name="colorOnPrimary">@color/trail_on_primary</item>
        <item name="colorPrimaryContainer">@color/trail_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/trail_on_primary_container</item>
        <item name="colorSecondary">@color/trail_secondary</item>
        <item name="colorOnSecondary">@color/trail_on_secondary</item>
        <item name="colorSurface">@color/trail_surface</item>
        <item name="colorOnSurface">@color/trail_on_surface</item>
        <item name="colorSurfaceVariant">@color/trail_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/trail_on_surface_variant</item>
        <item name="colorOutline">@color/trail_outline</item>
        <item name="colorError">@color/trail_error</item>
        <item name="colorOnError">@color/trail_on_error</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialButtonStyle">@style/Widget.TrailRelay.Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.TrailRelay.Dialog</item>
    </style>

    <style name="Widget.TrailRelay.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/trail_corner_radius</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.TrailRelay.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/trail_corner_radius</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>

    <style name="Widget.TrailRelay.MapButton" parent="Widget.Material3.Button.ElevatedButton">
        <item name="cornerRadius">@dimen/trail_corner_radius</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="backgroundTint">@color/trail_surface</item>
        <item name="android:textColor">@color/trail_on_surface</item>
    </style>

    <style name="Widget.TrailRelay.SearchField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/trail_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/trail_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/trail_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/trail_corner_radius</item>
    </style>

    <style name="Widget.TrailRelay.ExploreRow" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textColor">@color/trail_on_surface</item>
        <item name="iconTint">@color/trail_on_surface</item>
        <item name="iconSize">@dimen/icon_size</item>
        <item name="iconPadding">@dimen/space_content</item>
    </style>

    <style name="Widget.TrailRelay.FilterField" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/trail_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/trail_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/trail_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/trail_corner_radius</item>
    </style>

    <style name="ThemeOverlay.TrailRelay.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.TrailRelay.BottomSheet</item>
        <item name="enableEdgeToEdge">true</item>
    </style>
    <style name="Widget.TrailRelay.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="paddingBottomSystemWindowInsets">true</item>
        <item name="paddingLeftSystemWindowInsets">true</item>
        <item name="paddingRightSystemWindowInsets">true</item>
    </style>

    <style name="Widget.TrailRelay.StatusChip" parent="Widget.Material3.Chip.Assist">
        <item name="android:minHeight">0dp</item>
        <item name="chipMinHeight">@dimen/status_chip_height</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="chipIconSize">@dimen/status_icon_size</item>
        <item name="chipStartPadding">@dimen/space_related</item>
        <item name="chipEndPadding">@dimen/space_related</item>
        <item name="textStartPadding">@dimen/space_tight</item>
        <item name="textEndPadding">0dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
    </style>

    <style name="ThemeOverlay.TrailRelay.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.TrailRelay</item>
    </style>

    <style name="MaterialAlertDialog.TrailRelay" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.TrailRelay.Dialog</item>
    </style>

    <style name="ShapeAppearance.TrailRelay.Dialog" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/trail_corner_radius</item>
    </style>
    <style name="Widget.TrailRelay.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">@dimen/trail_corner_radius</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>
    <style name="Widget.TrailRelay.DestructiveButton" parent="Widget.TrailRelay.TextButton">
        <item name="android:textColor">@color/trail_error</item>
    </style>
    <style name="Widget.TrailRelay.MapControl" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:padding">@dimen/space_compact</item>
        <item name="android:background">@drawable/map_control_cell</item>
        <item name="android:tint">@color/map_control_ink</item>
        <item name="android:scaleType">centerInside</item>
    </style>
    <style name="Widget.TrailRelay.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_section</item>
        <item name="android:layout_marginBottom">@dimen/space_related</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="Widget.TrailRelay.MetricValue" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_tight</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
    </style>
</resources>
